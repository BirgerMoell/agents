LOCAL_LLM_MODEL=gpt-oss:20b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_EMBEDDING_MODEL=embeddinggemma
LOCAL_IMAGE_MODEL=filipstrand/Z-Image-Turbo-mflux-4bit
# LOCAL_IMAGE_GENERATOR=/Users/you/.local/bin/mflux-generate-z-image-turbo
LOCAL_VISION_MODEL=qwen3-vl:8b
# Swedish-first default. Set to parakeet for multilingual transcription.
LOCAL_STT_MODEL=pianissimo
# Fast Swedish default. Alternatives: chatterbox or kokoro.
LOCAL_VOICE_MODEL=supertonic
LOCAL_VOICE_LLM_MODEL=qwen3.5:4b
# Ollama ignores the key, but the OpenAI client requires a non-empty value.
LOCAL_LLM_API_KEY=ollama
# Optional: Tavily works in keyless mode with a shared limit. Add a key for reliable demos.
# TAVILY_API_KEY=tvly-...
